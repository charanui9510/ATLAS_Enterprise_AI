# AWS configuration
AWS_ACCESS_KEY_ID = "your-aws-key-id"
AWS_SECRET_ACCESS_KEY = "aws-seccret-key" 
S3_BUCKET = atlas-enterprise-ai-temp

##### AWS_REGION : in the new AWS console versions "AWS region is not availble. We ignore this"

#Bedrock model configuration 
BEDROCK_EMBED_MODEL = amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL = amazon.nova-lite-v1:0
EMBED_DIM = 1024


#Pinecone database configuration
PINECONE_API_KEY = "pinecone-api-key"
PINECONE_INDEX_HOST = "atlas-enterprise-ai-index"
PINECONE_CLOUD = AWS
##### PINECONE_REGION = Not found
PINECONE_READY_TIMEOUT = 180

#PostgreSQL database configuration
DATABASE_URL = postgreSQL-database-url-link

#RIUS observability configuration
RIUS_API_KEY = "Rius-api-key-id"
RIUS_SERVICE_NAME = atlas-enterprise-ai
RIUS_DISABLED = false
RIUS_CAPTURE_CONTENT = false  
